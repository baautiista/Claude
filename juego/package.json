{
  "name": "mi-linea",
  "version": "1.0.0",
  "description": "Mi Línea: juego narrativo de InfoLinense ambientado en La Línea de la Concepción",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "mapa": "node scripts/geojson-a-mapa.mjs",
    "servidor": "node --experimental-strip-types --no-warnings servidor/index.ts",
    "pruebas": "node --experimental-strip-types --no-warnings pruebas/todas.ts",
    "fuentes": "python3 scripts/sector/fuentes.py",
    "sector": "python3 scripts/sector/ciudad.py --punto",
    "ciudad": "python3 scripts/sector/ciudad.py",
    "importar": "python3 scripts/sector/importar.py"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.22.0"
  }
}
